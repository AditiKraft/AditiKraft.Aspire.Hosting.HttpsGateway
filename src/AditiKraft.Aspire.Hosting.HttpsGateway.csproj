<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAspireHostingPackage>true</IsAspireHostingPackage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AditiKraft.Aspire.Hosting.HttpsGateway</PackageId>
    <Title>AditiKraft Aspire HTTPS Gateway</Title>
    <Description>Local Aspire AppHost HTTPS gateway with YARP host/path routing, ACME DNS-01 certificate management, and optional S3-compatible certificate caching.</Description>
    <Authors>Aditi Kraft Private Limited</Authors>
    <Company>Aditi Kraft Private Limited</Company>
    <Copyright>Copyright © 2026 Aditi Kraft Private Limited</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>aspire;yarp;https;gateway;reverse-proxy;acme;letsencrypt;cloudflare;s3;r2</PackageTags>
    <RepositoryUrl>https://github.com/AditiKraft/AditiKraft.Aspire.Hosting.HttpsGateway</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AditiKraft/AditiKraft.Aspire.Hosting.HttpsGateway</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.3.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.23" />
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\AditiKraft.Aspire.Hosting.HttpsGateway.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
